{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "USE_STATIC_OPENSSL": "ON",
                "BACKUP_SYSTEM": "BAREOS"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (Ninja)",
            "description": "Windows Release build with MSVC and Ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QTDIR}"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-msvc-x64"
                }
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (Ninja)",
            "description": "Windows Debug build with MSVC and Ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "$env{QTDIR}",
                "DEBUG_PACKETS": "ON",
                "DEBUG_JSON": "ON",
                "LOG_JSON": "ON"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "intelliSenseMode": "windows-msvc-x64"
                }
            }
        },
        {
            "name": "windows-nmake-release",
            "displayName": "Windows Release (NMake)",
            "description": "Windows Release build with MSVC and NMake",
            "inherits": "base",
            "generator": "NMake Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QTDIR}"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "description": "Linux Release build with GCC",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "description": "Linux Debug build with GCC",
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DEBUG_PACKETS": "ON",
                "DEBUG_JSON": "ON",
                "LOG_JSON": "ON"
            }
        },
        {
            "name": "linux-ninja-release",
            "displayName": "Linux Release (Ninja)",
            "description": "Linux Release build with GCC and Ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-ninja-debug",
            "displayName": "Linux Debug (Ninja)",
            "description": "Linux Debug build with GCC and Ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DEBUG_PACKETS": "ON",
                "DEBUG_JSON": "ON",
                "LOG_JSON": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-release",
            "displayName": "Windows Release",
            "configurePreset": "windows-release"
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-nmake-release",
            "displayName": "Windows Release (NMake)",
            "configurePreset": "windows-nmake-release"
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "configurePreset": "linux-release",
            "jobs": 0
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "configurePreset": "linux-debug",
            "jobs": 0
        },
        {
            "name": "linux-ninja-release",
            "displayName": "Linux Release (Ninja)",
            "configurePreset": "linux-ninja-release"
        },
        {
            "name": "linux-ninja-debug",
            "displayName": "Linux Debug (Ninja)",
            "configurePreset": "linux-ninja-debug"
        }
    ]
}
