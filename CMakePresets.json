{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "USE_STATIC_OPENSSL": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (with logging)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ONESIMUS_FILE_LOGGING": "ON",
        "DEBUG_PACKETS": "ON",
        "DEBUG_JSON": "ON",
        "LOG_JSON": "ON"
      },
      "environment": {
        "ONESIMUS_VERBOSE": "1"
      }
    },
    {
      "name": "linux-debug-nolog",
      "displayName": "Linux Debug (no logging)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ONESIMUS_FILE_LOGGING": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (with logging)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ONESIMUS_FILE_LOGGING": "ON"
      },
      "environment": {
        "ONESIMUS_VERBOSE": "1"
      }
    },
    {
      "name": "linux-release-nolog",
      "displayName": "Linux Release (no logging)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ONESIMUS_FILE_LOGGING": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/BUILD",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}",
        "PERL_EXECUTABLE": "C:/Strawberry/perl/bin/perl.exe"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (with logging)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ONESIMUS_FILE_LOGGING": "ON"
      },
      "environment": {
        "ONESIMUS_VERBOSE": "1"
      }
    },
    {
      "name": "windows-debug-nolog",
      "displayName": "Windows Debug (no logging)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ONESIMUS_FILE_LOGGING": "OFF"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (with logging)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ONESIMUS_FILE_LOGGING": "ON"
      },
      "environment": {
        "ONESIMUS_VERBOSE": "1"
      }
    },
    {
      "name": "windows-release-nolog",
      "displayName": "Windows Release (no logging)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ONESIMUS_FILE_LOGGING": "OFF"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo (with logging)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ONESIMUS_FILE_LOGGING": "ON"
      },
      "environment": {
        "ONESIMUS_VERBOSE": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug-build",
      "displayName": "Linux Debug Build",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-debug-nolog-build",
      "displayName": "Linux Debug Build (no logging)",
      "configurePreset": "linux-debug-nolog"
    },
    {
      "name": "linux-release-build",
      "displayName": "Linux Release Build",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-release-nolog-build",
      "displayName": "Linux Release Build (no logging)",
      "configurePreset": "linux-release-nolog"
    },
    {
      "name": "windows-debug-build",
      "displayName": "Windows Debug Build",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-debug-nolog-build",
      "displayName": "Windows Debug Build (no logging)",
      "configurePreset": "windows-debug-nolog",
      "configuration": "Debug"
    },
    {
      "name": "windows-release-build",
      "displayName": "Windows Release Build",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-release-nolog-build",
      "displayName": "Windows Release Build (no logging)",
      "configurePreset": "windows-release-nolog",
      "configuration": "Release"
    },
    {
      "name": "windows-relwithdebinfo-build",
      "displayName": "Windows RelWithDebInfo Build",
      "configurePreset": "windows-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "linux-test",
      "displayName": "Linux Tests",
      "configurePreset": "linux-debug"
    },
    {
      "name": "windows-test",
      "displayName": "Windows Tests",
      "configurePreset": "windows-debug"
    }
  ],
  "packagePresets": [
    {
      "name": "linux-package",
      "displayName": "Linux DEB Package",
      "configurePreset": "linux-release",
      "generators": ["DEB"]
    },
    {
      "name": "windows-package",
      "displayName": "Windows NSIS Installer",
      "configurePreset": "windows-release",
      "generators": ["NSIS"]
    }
  ]
}
