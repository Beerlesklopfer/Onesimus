#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	cargo build --release -p bareos-dird -p bareos-console

override_dh_auto_install:
	# === bareos-director-rust package ===
	install -D -m 755 target/release/bareos-dird debian/bareos-director-rust/usr/sbin/bareos-dird
	# Schema
	install -D -m 644 catalog/schema/v001_initial.json debian/bareos-director-rust/usr/lib/bareos/scripts/ddl/v001_initial.json
	install -D -m 644 catalog/schema/v002_remove_metadata_bloat.json debian/bareos-director-rust/usr/lib/bareos/scripts/ddl/v002_remove_metadata_bloat.json
	# Default configs
	for dir in catalog client console director fileset job jobdefs messages pool profile schedule storage user; do \
		install -d debian/bareos-director-rust/usr/share/bareos/defaultconfigs/bareos-dir.d/$$dir; \
	done
	for f in config/bareos-dir.d/*/; do \
		install -m 644 $$f*.conf debian/bareos-director-rust/usr/share/bareos/defaultconfigs/bareos-dir.d/$$(basename $$f)/ 2>/dev/null || true; \
	done
	# === brconsole package ===
	install -D -m 755 target/release/brconsole debian/bareos-bconsole-rust/usr/bin/brconsole
	install -D -m 644 config/brconsole.conf debian/bareos-bconsole-rust/usr/share/bareos/defaultconfigs/brconsole.conf

override_dh_auto_test:
	cargo test --release

override_dh_strip:
	strip debian/bareos-director-rust/usr/sbin/bareos-dird
	strip debian/bareos-bconsole-rust/usr/bin/brconsole

override_dh_auto_clean:
	cargo clean 2>/dev/null || true
