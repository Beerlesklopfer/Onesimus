#!/bin/bash
set -e

case "$1" in
    configure)
        if [ ! -f /etc/bareos/brconsole.conf ]; then
            install -D -m 640 -o root -g bareos \
                /usr/share/bareos/defaultconfigs/brconsole.conf \
                /etc/bareos/brconsole.conf 2>/dev/null || true

            # Passwort aus Director-Installation uebernehmen (out-of-the-box)
            if [ -f /etc/bareos/.rndpwd ]; then
                DIR_PW=$(cat /etc/bareos/.rndpwd)
                sed -i "s/CHANGEME/${DIR_PW}/" /etc/bareos/brconsole.conf 2>/dev/null || true
                echo "brconsole: Passwort automatisch aus Director-Config uebernommen."
            else
                echo "brconsole: WARNUNG — Passwort manuell in /etc/bareos/brconsole.conf setzen!"
            fi
        fi
        echo "brconsole installiert: /usr/bin/brconsole"
        ;;
esac

#DEBHELPER#

exit 0
