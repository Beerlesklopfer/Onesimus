#!/bin/bash
set -e

case "$1" in
    configure)
        # Config-Datei anlegen falls nicht vorhanden
        if [ ! -f /etc/bareos/oconsole.conf ]; then
            install -D -m 640 -o root -g bareos \
                /usr/share/bareos/defaultconfigs/oconsole.conf \
                /etc/bareos/oconsole.conf 2>/dev/null || true
        fi

        # Passwort IMMER aus Director-Config synchronisieren
        # 1. Versuch: aus .rndpwd (Neuinstallation)
        # 2. Versuch: direkt aus Director-Config auslesen (bestehende Installation)
        DIR_PW=""
        if [ -f /etc/bareos/.rndpwd ]; then
            DIR_PW=$(cat /etc/bareos/.rndpwd 2>/dev/null)
        fi

        if [ -z "$DIR_PW" ]; then
            # Aus Director-Config extrahieren (C++ oder Rust)
            for f in /etc/bareos/bareos-dir.d/director/*.conf /etc/bareos/bareos-dir.conf; do
                if [ -f "$f" ]; then
                    DIR_PW=$(grep -i 'Password' "$f" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/')
                    if [ -n "$DIR_PW" ]; then
                        break
                    fi
                fi
            done
        fi

        if [ -n "$DIR_PW" ]; then
            # Passwort in oconsole.conf setzen (ersetzt CHANGEME oder altes Passwort)
            sed -i "s|Password = .*|Password = \"${DIR_PW}\"|" /etc/bareos/oconsole.conf 2>/dev/null || true
            echo "oconsole: Passwort aus Director-Config synchronisiert."
        else
            echo "oconsole: WARNUNG — kein Director-Passwort gefunden!"
            echo "  Bitte manuell setzen: /etc/bareos/oconsole.conf"
        fi

        echo "brconsole installiert: /usr/bin/oconsole"
        ;;
esac

#DEBHELPER#

exit 0
