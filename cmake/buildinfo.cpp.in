// Generated by cmake/BuildInfo.cmake on every build; rewritten only when a
// value changed, so an unchanged build compiles nothing.

#include "version.h"

namespace BuildInfo {
const int number = @BUILD_NUMBER@;
const char *const versionFull = "@PROJECT_VERSION@.@BUILD_NUMBER@";
const char *const sourceDate = "@SOURCE_DATE@";
const char *const sourceTime = "@SOURCE_TIME@";
const char *const gitCommit = "@GIT_COMMIT_HASH@";
const char *const gitBranch = "@GIT_BRANCH@";
const char *const gitDescribe = "@GIT_DESCRIBE@";
} // namespace BuildInfo
