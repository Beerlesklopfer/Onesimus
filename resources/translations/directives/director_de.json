{
  "resource_type": "Director",
  "resource_type_description": "Die Director-Ressource verwaltet alle Backup-Operationen, koordiniert Jobs und pflegt den Backup-Katalog",
  "directives": {
    "Name": {
      "description": "Der eindeutige Name der Director-Ressource",
      "example_description": "Typischerweise der Hostname mit '-dir'-Suffix"
    },
    "Description": {
      "description": "Optionale, lesbare Beschreibung dieses Directors",
      "example_description": "Produktions-Backup-Server"
    },
    "Password": {
      "description": "Passwort für Director-Authentifizierung (MD5-Hash mit [md5]-Präfix erforderlich)",
      "example_description": "MD5-Hash des Klartextpassworts"
    },
    "Messages": {
      "description": "Name der Messages-Ressource für Director-Nachrichten",
      "example_description": "Standard-Nachrichtenbehandlung"
    },
    "DirPort": {
      "description": "TCP-Port, auf dem der Director auf Console-Verbindungen wartet",
      "example_description": "Standard-Bareos-Director-Port"
    },
    "DirAddress": {
      "description": "IP-Adresse oder Hostname, auf dem der Director wartet (0.0.0.0 = alle Schnittstellen)",
      "example_description": "Auf allen Netzwerkschnittstellen lauschen"
    },
    "DirAddresses": {
      "description": "Liste von IP-Adressen und Ports für den Director",
      "example_description": "IPv4- und IPv6-Adressen mit Ports"
    },
    "QueryFile": {
      "description": "Pfad zur Query-Datei mit vordefinierten SQL-Abfragen",
      "example_description": "Standard-Bareos-Query-Datei"
    },
    "Working Directory": {
      "description": "Verzeichnis, in dem der Director seine Arbeitsdateien speichert",
      "example_description": "Standard-Bareos-Arbeitsverzeichnis"
