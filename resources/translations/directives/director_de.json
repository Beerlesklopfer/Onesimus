      "description": "Befehl zum sicheren Löschen von Dateien (nur Bareos)",
      "example_description": "Shred für sicheres Löschen verwenden"
    },
    "Log Timestamp Format": {
      "description": "Format für Zeitstempel in Log-Nachrichten (nur Bareos)",
      "example_description": "ISO 8601 Format"
    },
    "NDMP Log Level": {
      "description": "Log-Level für NDMP-Operationen (nur Bareos)",
      "example_description": "Standard-Logging-Level"
    }
