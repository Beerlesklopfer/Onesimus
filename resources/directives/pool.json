{
  "resource_type": "Pool",
  "description": "Pool resource directives for Bareos and Bacula (volume pools for backup storage)",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The unique name of the Pool resource",
      "example": "Full-Pool",
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Optional description of this Pool",
      "example": "Pool for full backups",
      "excludes": [],
      "must": []
    },
    "Pool Type": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "valid_values": ["Backup", "Archive", "Cloned", "Migration", "Copy", "Save"],
      "default": "Backup",
      "description": "Type of pool",
      "example": "Backup",
      "synonyms": ["PoolType"],
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Storage": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "reference_type": "Storage",
      "description": "Default Storage resource for this Pool",
      "example": "File-Storage",
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Maximum Volumes": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": 0,
      "min": 0,
      "description": "Maximum number of volumes in this Pool (0 = unlimited)",
      "example": 100,
      "synonyms": ["MaximumVolumes", "Maximum Volume Files"],
      "group": "volumes",
      "excludes": [],
      "must": []
    },
    "Maximum Volume Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Maximum jobs per volume (0 = unlimited)",
      "example": 1,
      "synonyms": ["MaximumVolumeJobs"],
      "group": "volumes",
      "excludes": [],
      "must": []
    },
    "Maximum Volume Files": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Maximum files per volume (0 = unlimited)",
      "example": 10000,
      "synonyms": ["MaximumVolumeFiles"],
      "group": "volumes",
      "excludes": [],
      "must": []
    },
    "Maximum Volume Bytes": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": 0,
      "min": 0,
      "description": "Maximum size of a volume (0 = unlimited)",
      "example": "50G",
      "synonyms": ["MaximumVolumeBytes"],
      "group": "volumes",
      "excludes": [],
      "must": []
    },
    "Volume Use Duration": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Time period a volume can be written to",
      "example": "23 hours",
      "synonyms": ["VolumeUseDuration"],
      "group": "volumes",
      "excludes": [],
      "must": []
    },
    "Volume Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": "365 days",
      "description": "Minimum time to retain volumes before recycling",
      "example": "1 year",
      "synonyms": ["VolumeRetention"],
      "group": "retention",
      "excludes": [],
      "must": []
    },
    "File Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "How long to retain File records in catalog",
      "example": "60 days",
      "synonyms": ["FileRetention"],
      "group": "retention",
      "excludes": [],
      "must": []
    },
    "Job Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "How long to retain Job records in catalog",
      "example": "6 months",
      "synonyms": ["JobRetention"],
      "group": "retention",
      "excludes": [],
      "must": []
    },
    "AutoPrune": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Automatically prune expired File and Job records",
      "example": true,
      "group": "retention",
      "excludes": [],
      "must": []
    },
    "Recycle": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Allow automatic recycling of volumes",
      "example": true,
      "group": "recycling",
      "excludes": [],
      "must": []
    },
    "Recycle Oldest Volume": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Recycle oldest volume when pool is full",
      "example": true,
      "synonyms": ["RecycleOldestVolume"],
      "group": "recycling",
      "excludes": ["Purge Oldest Volume"],
      "must": []
    },
    "Recycle Current Volume": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Immediately recycle current volume after use",
      "example": false,
      "synonyms": ["RecycleCurrentVolume"],
      "group": "recycling",
      "excludes": [],
      "must": []
    },
    "Purge Oldest Volume": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Purge oldest volume when pool is full",
      "example": false,
      "synonyms": ["PurgeOldestVolume"],
      "group": "recycling",
      "excludes": ["Recycle Oldest Volume"],
      "must": []
    },
    "Action On Purge": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "valid_values": ["None", "Truncate"],
      "default": "None",
      "description": "Action to perform when volume is purged",
      "example": "Truncate",
      "synonyms": ["ActionOnPurge"],
      "min_version": "3.1.6",
      "excludes": [],
      "must": []
    },
    "Scratch Pool": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "reference_type": "Pool",
      "description": "Scratch pool to get volumes from when this pool is empty",
      "example": "Scratch",
      "synonyms": ["ScratchPool"],
      "group": "recycling",
      "excludes": [],
      "must": []
    },
    "Recycle Pool": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "reference_type": "Pool",
      "description": "Pool to send volumes when recycled",
      "example": "Recycle-Pool",
      "synonyms": ["RecyclePool"],
      "group": "recycling",
      "excludes": [],
      "must": []
    },
    "Next Pool": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "reference_type": "Pool",
      "description": "Pool to use for next backup level (e.g., Full → Differential)",
      "example": "Incremental-Pool",
      "synonyms": ["NextPool"],
      "min_version": "3.1.3",
      "excludes": [],
      "must": []
    },
    "Migration Time": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Jobs older than this are eligible for migration",
      "example": "30 days",
      "synonyms": ["MigrationTime"],
      "group": "migration",
      "excludes": [],
      "must": []
    },
    "Migration High Bytes": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Migrate when pool exceeds this size",
      "example": "100G",
      "synonyms": ["MigrationHighBytes"],
      "group": "migration",
      "excludes": [],
      "must": ["Migration Low Bytes"]
    },
    "Migration Low Bytes": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Stop migration when pool size falls below this",
      "example": "50G",
      "synonyms": ["MigrationLowBytes"],
      "group": "migration",
      "excludes": [],
      "must": ["Migration High Bytes"]
    },
    "Label Format": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Format for automatic volume labels (use variables like ${Year}${Month}${Day})",
      "example": "Vol-${Year}-${Month}-${Day}-${Hour}${Minute}${Second}",
      "synonyms": ["LabelFormat"],
      "group": "labeling",
      "excludes": [],
      "must": []
    },
    "Label Type": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "valid_values": ["bareos", "ansi", "ibm"],
      "default": "bareos",
      "description": "Type of tape label (Bareos only)",
      "example": "bareos",
      "min_version": "13.2.0",
      "group": "labeling",
      "excludes": [],
      "must": []
    },
    "Cleaning Prefix": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Prefix for cleaning tape volumes",
      "example": "CLN",
      "synonyms": ["CleaningPrefix"],
      "group": "labeling",
      "excludes": [],
      "must": []
    },
    "Catalog Files": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": true,
      "description": "Catalog individual files (disable for faster catalog)",
      "example": true,
      "synonyms": ["CatalogFiles"],
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Maximum concurrent jobs using this Pool (0 = unlimited, Bareos only)",
      "example": 5,
      "min_version": "14.2.0",
      "group": "performance",
      "excludes": [],
      "must": []
    },
    "Minimum Block Size": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Minimum block size for volumes (Bareos only)",
      "example": "64512",
      "min_version": "16.2.4",
      "group": "performance",
      "excludes": [],
      "must": []
    },
    "Maximum Block Size": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Maximum block size for volumes (Bareos only)",
      "example": "1048576",
      "min_version": "16.2.4",
      "group": "performance",
      "excludes": [],
      "must": []
    }
  }
}
