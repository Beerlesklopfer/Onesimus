{
  "resource_type": "Catalog",
  "description": "Catalog resource directives for Bareos and Bacula database backend configuration",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The unique name of the Catalog resource",
      "example": "MyCatalog",
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Optional description of this Catalog",
      "example": "Primary Bareos catalog database",
      "excludes": [],
      "must": []
    },
    "DB Driver": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": true,
      "valid_values": ["postgresql", "mysql", "sqlite3"],
      "default": "postgresql",
      "description": "Database backend driver (Bareos only, deprecated since 21.0.0 — always PostgreSQL)",
      "example": "postgresql",
      "synonyms": ["DbDriver", "dbdriver"],
      "group": "database",
      "excludes": [],
      "must": []
    },
    "DB Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": "bareos",
      "description": "Name of the database",
      "example": "bareos",
      "synonyms": ["DbName", "dbname"],
      "group": "database",
      "excludes": [],
      "must": []
    },
    "DB Address": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Hostname or IP address of the database server (empty = local socket)",
      "example": "localhost",
      "synonyms": ["DbAddress", "dbaddress"],
      "group": "database",
      "excludes": ["DB Socket"],
      "must": []
    },
    "DB Port": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": 0,
      "min": 0,
      "max": 65535,
      "description": "TCP port of the database server (0 = default for the driver)",
      "example": 5432,
      "synonyms": ["DbPort", "dbport"],
      "group": "database",
      "excludes": [],
      "must": ["DB Address"]
    },
    "DB Socket": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to database Unix socket (alternative to DB Address)",
      "example": "/var/run/postgresql/.s.PGSQL.5432",
      "synonyms": ["DbSocket", "dbsocket"],
      "group": "database",
      "excludes": ["DB Address"],
      "must": []
    },
    "DB User": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": "bareos",
      "description": "Username for database authentication",
      "example": "bareos",
      "synonyms": ["DbUser", "dbuser"],
      "group": "authentication",
      "excludes": [],
      "must": []
    },
    "DB Password": {
      "type": "password",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Password for database authentication",
      "example": "",
      "synonyms": ["DbPassword", "dbpassword"],
      "group": "authentication",
      "excludes": [],
      "must": []
    },
    "Multiple Connections": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Allow multiple simultaneous database connections (not recommended)",
      "example": false,
      "synonyms": ["MultipleConnections"],
      "excludes": [],
      "must": []
    },
    "Disable Batch Insert": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": false,
      "description": "Disable batch INSERT for file attribute insertion (slower but uses less memory)",
      "example": false,
      "synonyms": ["DisableBatchInsert"],
      "excludes": [],
      "must": []
    },
    "Reconnect": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": false,
      "description": "Automatically reconnect to the database if connection is lost (Bareos only)",
      "example": true,
      "min_version": "15.2.0",
      "excludes": [],
      "must": []
    },
    "Exit On Fatal": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": false,
      "description": "Exit Director on fatal database errors (Bareos only)",
      "example": false,
      "min_version": "15.2.0",
      "excludes": [],
      "must": []
    },
    "Idle Timeout": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 30,
      "min": 0,
      "description": "Timeout in seconds before idle database connections are closed (0 = no timeout, Bareos only)",
      "example": 30,
      "synonyms": ["IdleTimeout"],
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Inc Connections": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 1,
      "min": 0,
      "description": "Number of connections to add when pool is exhausted (Bareos only)",
      "example": 1,
      "synonyms": ["IncConnections"],
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Max Connections": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 5,
      "min": 1,
      "description": "Maximum number of database connections in the pool (Bareos only)",
      "example": 5,
      "synonyms": ["MaxConnections"],
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Min Connections": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 1,
      "min": 0,
      "description": "Minimum number of database connections in the pool (Bareos only)",
      "example": 1,
      "synonyms": ["MinConnections"],
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Validate Timeout": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": 120,
      "min": 0,
      "description": "Timeout in seconds for validating database connections (Bareos only)",
      "example": 120,
      "synonyms": ["ValidateTimeout"],
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    }
  }
}
