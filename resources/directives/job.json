{
  "resource_type": "Job",
  "description": "Job resource directives for defining backup, restore, verify, and admin jobs in Bareos and Bacula",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Unique name for this Job resource",
      "example": "BackupClient1",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Optional description of this Job",
      "example": "Daily backup of web server",
      "excludes": [],
      "must": []
    },
    "Type": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "valid_values": ["Backup", "Restore", "Verify", "Admin", "Migrate", "Copy", "Consolidate"],
      "description": "The type of job to run",
      "example": "Backup",
      "excludes": [],
      "must": []
    },
    "Protocol": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "valid_values": ["Native", "NDMP", "NDMP_BAREOS", "NDMP_NATIVE"],
      "default": "Native",
      "description": "Backup protocol to use (Bareos only)",
      "example": "Native",
      "min_version": "13.2.0",
      "excludes": [],
      "must": []
    },
    "Level": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "valid_values": ["Full", "Incremental", "Differential", "VirtualFull", "Catalog", "InitCatalog", "VolumeToCatalog", "DiskToCatalog", "Data"],
      "default": "Incremental",
      "description": "The backup level for this job",
      "example": "Full",
      "excludes": [],
      "must": []
    },
    "Client": {
      "type": "resource_reference",
      "reference_type": "Client",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The Client (File Daemon) to backup",
      "example": "client-fd",
      "excludes": [],
      "must": []
    },
    "FileSet": {
      "type": "resource_reference",
      "reference_type": "FileSet",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The FileSet defining what files to backup",
      "example": "Full Set",
      "excludes": [],
      "must": []
    },
    "Schedule": {
      "type": "resource_reference",
      "reference_type": "Schedule",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The Schedule defining when to run this job",
      "example": "WeeklyCycle",
      "excludes": [],
      "must": []
    },
    "Storage": {
      "type": "resource_reference",
      "reference_type": "Storage",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The Storage daemon to use for this job",
      "example": "File",
      "excludes": [],
      "must": []
    },
    "Pool": {
      "type": "resource_reference",
      "reference_type": "Pool",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The Pool to use for volumes",
      "example": "Default",
      "excludes": [],
      "must": []
    },
    "Full Backup Pool": {
      "type": "resource_reference",
      "reference_type": "Pool",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Override Pool for Full backups",
      "example": "Full",
      "excludes": [],
      "must": []
    },
    "Differential Backup Pool": {
      "type": "resource_reference",
      "reference_type": "Pool",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Override Pool for Differential backups",
      "example": "Differential",
      "excludes": [],
      "must": []
    },
    "Incremental Backup Pool": {
      "type": "resource_reference",
      "reference_type": "Pool",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Override Pool for Incremental backups",
      "example": "Incremental",
      "excludes": [],
      "must": []
    },
    "Messages": {
      "type": "resource_reference",
      "reference_type": "Messages",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The Messages resource for job output",
      "example": "Standard",
      "excludes": [],
      "must": []
    },
    "JobDefs": {
      "type": "resource_reference",
      "reference_type": "JobDefs",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Reference to a JobDefs resource for default values",
      "example": "DefaultJob",
      "excludes": [],
      "must": []
    },
    "Priority": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "min": 1,
      "max": 100,
      "default": 10,
      "description": "Job priority (lower number = higher priority)",
      "example": 10,
      "excludes": [],
      "must": []
    },
    "Enabled": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Enable or disable this job",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Accurate": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Enable accurate backups (better detection of deleted/moved files)",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "min": 1,
      "max": 1000,
      "default": 1,
      "description": "Maximum concurrent instances of this job",
      "example": 1,
      "excludes": [],
      "must": []
    },
    "Maximum Bandwidth": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Maximum bandwidth for this job (bytes/sec)",
      "example": "10 mb/s",
      "excludes": [],
      "must": []
    },
    "Spool Data": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Spool data before writing to tape",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Spool Attributes": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Spool file attributes before writing to catalog",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Spool Size": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Maximum spool file size",
      "example": "10g",
      "excludes": [],
      "must": ["Spool Data"]
    },
    "Prefer Mounted Volumes": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": true,
      "description": "Prefer volumes already mounted in drives",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Write Bootstrap": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path for bootstrap file (disaster recovery)",
      "example": "/var/lib/bareos/%c.bsr",
      "excludes": [],
      "must": []
    },
    "Write Verify List": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path for verify list file",
      "example": "/var/lib/bareos/%c.verify",
      "excludes": [],
      "must": []
    },
    "Max Run Time": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Maximum job run time before cancellation",
      "example": "24 hours",
      "excludes": [],
      "must": []
    },
    "Max Wait Time": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Maximum wait time for resources",
      "example": "1 hour",
      "excludes": [],
      "must": []
    },
    "Max Start Delay": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Maximum delay before job starts",
      "example": "2 hours",
      "excludes": [],
      "must": []
    },
    "Max Full Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Maximum interval between Full backups (Bareos only)",
      "example": "30 days",
      "min_version": "12.4.0",
      "excludes": [],
      "must": []
    },
    "Max Diff Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Maximum interval between Differential backups (Bareos only)",
      "example": "7 days",
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Reschedule On Error": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Reschedule job if it fails",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Reschedule Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 1800,
      "description": "Wait time before rescheduling (seconds)",
      "example": "30 minutes",
      "excludes": [],
      "must": ["Reschedule On Error"]
    },
    "Reschedule Times": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "min": 0,
      "max": 100,
      "default": 5,
      "description": "Number of reschedule attempts",
      "example": 3,
      "excludes": [],
      "must": ["Reschedule On Error"]
    },
    "Allow Duplicate Jobs": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": true,
      "description": "Allow multiple instances of same job to run",
      "example": false,
      "excludes": [],
      "must": []
    },
    "Allow Higher Duplicates": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": true,
      "description": "Allow duplicate jobs at higher level to run",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Cancel Lower Level Duplicates": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Cancel running lower-level jobs when higher-level starts",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Cancel Queued Duplicates": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Cancel queued duplicate jobs",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Cancel Running Duplicates": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Cancel running duplicate jobs",
      "example": false,
      "excludes": [],
      "must": []
    },
    "Run Before Job": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Command to run before job starts (on Director)",
      "example": "/etc/bareos/scripts/pre-backup.sh",
      "excludes": [],
      "must": []
    },
    "Run After Job": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Command to run after job completes successfully (on Director)",
      "example": "/etc/bareos/scripts/post-backup.sh",
      "excludes": [],
      "must": []
    },
    "Run After Failed Job": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Command to run after job fails (on Director)",
      "example": "/etc/bareos/scripts/backup-failed.sh",
      "excludes": [],
      "must": []
    },
    "Client Run Before Job": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Command to run on Client before backup",
      "example": "\"C:/Program Files/scripts/pre-backup.bat\"",
      "excludes": [],
      "must": []
    },
    "Client Run After Job": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Command to run on Client after backup",
      "example": "\"/opt/scripts/post-backup.sh\"",
      "excludes": [],
      "must": []
    },
    "Rerun Failed Levels": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Re-run job at same level if previous job failed",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Catalog": {
      "type": "resource_reference",
      "reference_type": "Catalog",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Override default catalog for this job",
      "example": "MyCatalog",
      "excludes": [],
      "must": []
    },
    "Where": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Prefix path for restore location",
      "example": "/tmp/bareos-restores",
      "excludes": ["RegexWhere"],
      "must": []
    },
    "RegexWhere": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Regex pattern for path substitution during restore",
      "example": "!^/!!/tmp/bareos-restores!",
      "excludes": ["Where"],
      "must": []
    },
    "Replace": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "valid_values": ["always", "ifnewer", "ifolder", "never"],
      "default": "always",
      "description": "File replacement policy during restore",
      "example": "ifnewer",
      "excludes": [],
      "must": []
    },
    "Prefix Links": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Prefix links with Where path during restore",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Add Prefix": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Add prefix to all file names during restore",
      "example": "/restore",
      "excludes": [],
      "must": []
    },
    "Add Suffix": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Add suffix to all file names during restore",
      "example": ".bak",
      "excludes": [],
      "must": []
    },
    "Strip Prefix": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Strip prefix from file names during restore",
      "example": "/data",
      "excludes": [],
      "must": []
    },
    "Selection Type": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "valid_values": ["SmallestVolume", "OldestVolume", "Client", "Volume", "Job", "SQLQuery", "PoolOccupancy", "PoolTime", "PoolUncopiedJobs"],
      "description": "Selection type for migration/copy jobs",
      "example": "SmallestVolume",
      "excludes": [],
      "must": []
    },
    "Selection Pattern": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Pattern for migration/copy job selection",
      "example": ".*",
      "excludes": [],
      "must": []
    },
    "Migration High Bytes": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Pool usage that triggers migration",
      "example": "500g",
      "excludes": [],
      "must": []
    },
    "Migration Low Bytes": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Pool usage target for migration",
      "example": "200g",
      "excludes": [],
      "must": []
    },
    "Migration Time": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Age of jobs to consider for migration",
      "example": "30 days",
      "excludes": [],
      "must": []
    },
    "Next Pool": {
      "type": "resource_reference",
      "reference_type": "Pool",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Destination pool for migration/copy jobs",
      "example": "Archive",
      "excludes": [],
      "must": []
    },
    "Purge Migration Job": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Purge original job after successful migration",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Verify Job": {
      "type": "resource_reference",
      "reference_type": "Job",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Job to verify against (for Verify jobs)",
      "example": "BackupClient1",
      "excludes": [],
      "must": []
    },
    "Base": {
      "type": "resource_reference",
      "reference_type": "Job",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Base job for BaseJob backups",
      "example": "BaseJob",
      "excludes": [],
      "must": []
    },
    "Plugin Options": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Plugin options string (Bareos only)",
      "example": "python:module_path=/etc/bareos:module_name=bareos-fd-mysql",
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    },
    "Run Script": {
      "type": "block",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Complex script definition block",
      "example": "{ Command = \"/path/script.sh\" RunsWhen = Before RunsOnClient = Yes }",
      "excludes": [],
      "must": []
    }
  },
  "job_types": {
    "Backup": {
      "description": "Backup job to copy files from Client to Storage",
      "required_directives": ["Client", "FileSet", "Storage", "Pool", "Messages"],
      "levels": ["Full", "Incremental", "Differential", "VirtualFull"]
    },
    "Restore": {
      "description": "Restore files from Storage to Client",
      "required_directives": ["Client", "FileSet", "Storage", "Pool", "Messages"],
      "typically_uses": ["Where", "Replace"]
    },
    "Verify": {
      "description": "Verify job to check backed up data",
      "required_directives": ["Client", "FileSet", "Storage", "Pool", "Messages"],
      "levels": ["Catalog", "InitCatalog", "VolumeToCatalog", "DiskToCatalog", "Data"],
      "note": "Different levels verify different aspects"
    },
    "Admin": {
      "description": "Administrative job for running scripts",
      "required_directives": ["Messages"],
      "note": "Typically uses Run Before Job/Run After Job"
    },
    "Migrate": {
      "description": "Move data from one pool to another",
      "required_directives": ["Pool", "Messages", "Next Pool"],
      "note": "Original data is marked for deletion"
    },
    "Copy": {
      "description": "Copy data from one pool to another",
      "required_directives": ["Pool", "Messages", "Next Pool"],
      "note": "Original data is preserved"
    },
    "Consolidate": {
      "description": "Consolidate incremental jobs into single backup (Bareos)",
      "required_directives": ["Client", "FileSet", "Storage", "Pool", "Messages"],
      "bareos_only": true,
      "min_version": "16.2.0"
    }
  },
  "backup_levels": {
    "Full": {
      "description": "Complete backup of all files in FileSet",
      "note": "All files are backed up regardless of modification time"
    },
    "Incremental": {
      "description": "Backup only files changed since last successful backup",
      "note": "Requires a previous Full or Incremental backup"
    },
    "Differential": {
      "description": "Backup all files changed since last Full backup",
      "note": "Requires a previous Full backup"
    },
    "VirtualFull": {
      "description": "Create a synthetic Full backup from existing Incremental/Differential",
      "bareos_only": true,
      "note": "Does not read data from Client, consolidates existing backups"
    }
  }
}
