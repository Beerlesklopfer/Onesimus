{
  "resource_type": "Client",
  "description": "Client (File Daemon) resource directives for Bareos and Bacula",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "description": "The name of the Client resource",
      "example": "client-fd",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Optional description of this Client",
      "example": "Web Server File Daemon",
      "excludes": [],
      "must": []
    },
    "Address": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "description": "Network address of the File Daemon",
      "example": "client.example.com",
      "excludes": [],
      "must": []
    },
    "FD Port": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 1,
      "max": 65535,
      "default": 9102,
      "description": "Port on which the File Daemon listens",
      "example": 9102,
      "excludes": [],
      "must": []
    },
    "Password": {
      "type": "password",
      "required": true,
      "bareos": true,
      "bacula": true,
      "description": "Password for Client authentication (MD5 hash)",
      "example": "[md5]482c811da5d5b4bc6d497ffa98491e38",
      "excludes": [],
      "must": []
    },
    "Catalog": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "reference_type": "Catalog",
      "description": "Catalog resource to use",
      "default": "MyCatalog",
      "example": "MyCatalog",
      "excludes": [],
      "must": []
    },
    "File Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Time to retain File records in catalog",
      "default": "60 days",
      "example": "90 days",
      "excludes": [],
      "must": []
    },
    "Job Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Time to retain Job records in catalog",
      "default": "180 days",
      "example": "365 days",
      "excludes": [],
      "must": []
    },
    "AutoPrune": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "description": "Enable automatic pruning of expired records",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 1,
      "max": 100,
      "default": 1,
      "description": "Maximum concurrent jobs for this client",
      "example": 5,
      "excludes": [],
      "must": []
    },
    "Heartbeat Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 0,
      "description": "Keepalive interval in seconds",
      "default": 0,
      "example": 300,
      "excludes": [],
      "must": []
    },
    "TLS Enable": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": true,
      "group": "tls",
      "description": "Enable TLS encryption",
      "example": true,
      "excludes": [],
      "must": []
    },
    "TLS Require": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls",
      "description": "Require TLS connection (yes for x509, no for PSK)",
      "example": true,
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS CA Certificate File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "platform": ["linux", "darwin", "freebsd"],
      "description": "Path to CA certificate file (PEM format, Unix only)",
      "example": "/etc/bareos/tls/bareos-ca.pem",
      "excludes": ["TLS Certificate File"],
      "must": ["TLS Enable"],
      "visible_when": {
        "directive": "TLS Require",
        "value": true
      }
    },
    "TLS Certificate": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "platform": ["linux", "darwin", "freebsd"],
      "description": "Path to certificate file (PEM format, Unix only)",
      "example": "/etc/bareos/tls/bareos-cert.pem",
      "excludes": ["TLS Certificate File"],
      "must": ["TLS Enable", "TLS Key"],
      "visible_when": {
        "directive": "TLS Require",
        "value": true
      }
    },
    "TLS Key": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "platform": ["linux", "darwin", "freebsd"],
      "description": "Path to private key file (PEM format, Unix only)",
      "example": "/etc/bareos/tls/bareos-key.pem",
      "excludes": ["TLS Certificate File"],
      "must": ["TLS Enable", "TLS Certificate"],
      "visible_when": {
        "directive": "TLS Require",
        "value": true
      }
    },
    "TLS Certificate File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-pfx",
      "platform": ["windows"],
      "description": "Path to PFX/PKCS#12 certificate file (Windows only, contains cert + key)",
      "example": "C:\\bareos\\tls\\bareos-fd.pfx",
      "excludes": ["TLS CA Certificate File", "TLS Certificate", "TLS Key"],
      "must": ["TLS Enable"],
      "visible_when": {
        "directive": "TLS Require",
        "value": true
      }
    },
    "TLS Cipher List": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-advanced",
      "description": "Colon-separated list of valid TLSv1.2 and lower ciphers",
      "example": "PSK-AES256-CBC-SHA:PSK-AES128-CBC-SHA",
      "valid_values": [
        "PSK-AES256-GCM-SHA384:PSK-AES128-GCM-SHA256:PSK-AES256-CBC-SHA:PSK-AES128-CBC-SHA",
        "PSK-AES256-GCM-SHA384:PSK-AES256-CBC-SHA",
        "PSK-AES128-GCM-SHA256:PSK-AES128-CBC-SHA",
        "ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:AES256-SHA256:AES128-SHA256",
        "AES256-SHA256:AES128-SHA256"
      ],
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Verify Peer": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls-x509",
      "description": "Verify peer certificate (x509 only)",
      "example": true,
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Allowed CN": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Allowed certificate Common Names (x509 only)",
      "example": ["bareos-dir.example.com"],
      "excludes": [],
      "must": ["TLS Enable", "TLS Verify Peer"]
    },
    "TLS Authenticate": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls",
      "description": "Use TLS only for authentication, not encryption",
      "example": false,
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS CA Certificate Dir": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "platform": ["linux", "darwin", "freebsd"],
      "description": "Path to directory containing CA certificates (x509 only, Unix)",
      "example": "/etc/bareos/tls/ca",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Cipher Suites": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "19.2.0",
      "group": "tls-advanced",
      "description": "Colon-separated list of valid TLSv1.3 cipher suites",
      "example": "TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS DH File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-advanced",
      "description": "Path to Diffie-Hellman parameter file for forward secrecy",
      "example": "/etc/bareos/tls/dh2048.pem",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Protocol": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "20.0.0",
      "group": "tls-advanced",
      "description": "OpenSSL protocol configuration string",
      "example": "-TLSv1,-TLSv1.1",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Certificate Revocation List": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to Certificate Revocation List file",
      "example": "/etc/bareos/tls/crl.pem",
      "synonyms": ["TLS CRL File"],
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "PKI Signatures": {
      "type": "boolean",
      "required": false,
      "bareos": false,
      "bacula": true,
      "default": false,
      "description": "Enable PKI signatures (Bacula only)",
      "example": true,
      "excludes": [],
      "must": []
    },
    "PKI Encryption": {
      "type": "boolean",
      "required": false,
      "bareos": false,
      "bacula": true,
      "default": false,
      "description": "Enable PKI encryption (Bacula only)",
      "example": true,
      "excludes": [],
      "must": []
    },
    "PKI Keypair": {
      "type": "file",
      "required": false,
      "bareos": false,
      "bacula": true,
      "description": "Path to PKI keypair file (Bacula only)",
      "example": "/etc/bacula/fd-cert.pem",
      "excludes": [],
      "must": ["PKI Encryption"]
    },
    "Plugin Directory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Directory containing plugins",
      "example": "/usr/lib/bareos/plugins",
      "excludes": [],
      "must": []
    },
    "SD Connect Timeout": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Timeout for connecting to Storage Daemon",
      "default": 1800,
      "example": 1800,
      "excludes": [],
      "must": []
    },
    "Maximum Network Buffer Size": {
      "type": "size",
      "required": false,
      "bareos": false,
      "bacula": true,
      "min": 1024,
      "max": 4194304,
      "description": "Maximum network buffer size (Bacula only)",
      "example": 65536,
      "excludes": [],
      "must": []
    },
    "Passive": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "nat",
      "description": "Client initiates connection to Director (for clients behind NAT/firewall)",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Connection From Client To Director": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "default": false,
      "group": "nat",
      "description": "Allow client-initiated connections (Bareos 16.2+)",
      "example": true,
      "excludes": [],
      "must": [],
      "min_version": "16.2.0"
    },
    "Connection From Director To Client": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "default": true,
      "group": "nat",
      "description": "Allow director-initiated connections (Bareos 16.2+)",
      "example": true,
      "excludes": [],
      "must": [],
      "min_version": "16.2.0"
    },
    "Connection From Client Wait": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": false,
      "default": 1800,
      "group": "nat",
      "description": "Time to wait for client-initiated connection (seconds)",
      "example": 3600,
      "excludes": [],
      "must": ["Passive"],
      "visible_when": {
        "directive": "Passive",
        "value": true
      },
      "min_version": "16.2.0"
    }
  }
}
