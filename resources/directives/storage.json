{
  "resource_type": "Storage",
  "description": "Storage resource directives for Bareos and Bacula Storage Daemon (SD) configuration",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The unique name of the Storage resource",
      "example": "File-Storage",
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Optional description of this Storage",
      "example": "Primary file-based storage",
      "excludes": [],
      "must": []
    },
    "Address": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Hostname or IP address of the Storage Daemon",
      "example": "storage.example.com",
      "group": "network",
      "excludes": [],
      "must": []
    },
    "SD Port": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": 9103,
      "min": 1,
      "max": 65535,
      "description": "TCP port on which the Storage Daemon listens",
      "example": 9103,
      "synonyms": ["SDPort"],
      "group": "network",
      "excludes": [],
      "must": []
    },
    "Password": {
      "type": "password",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Password for Storage Daemon authentication (MD5 hash with [md5] prefix)",
      "example": "[md5]5f4dcc3b5aa765d61d8327deb882cf99",
      "group": "authentication",
      "excludes": [],
      "must": []
    },
    "Device": {
      "type": "resource_reference",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "reference_type": "Device",
      "description": "Device resource to use for this Storage",
      "example": "FileChgr1-Dev1",
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Media Type": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Media type identifier (must match Device's Media Type)",
      "example": "File",
      "synonyms": ["MediaType"],
      "group": "basic",
      "excludes": [],
      "must": []
    },
    "Autochanger": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "reference_type": "Autochanger",
      "description": "Autochanger resource if using an autochanger",
      "example": "Autochanger-1",
      "group": "autochanger",
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": 1,
      "min": 1,
      "max": 1000,
      "description": "Maximum number of concurrent jobs for this Storage",
      "example": 10,
      "group": "performance",
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Read Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Maximum concurrent read jobs (0 = unlimited)",
      "example": 5,
      "group": "performance",
      "excludes": [],
      "must": []
    },
    "Allow Compression": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Allow client-side compression for jobs using this Storage",
      "example": true,
      "group": "performance",
      "excludes": [],
      "must": []
    },
    "Heartbeat Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": 0,
      "min": 0,
      "description": "Keepalive interval in seconds (0 = disabled)",
      "example": 300,
      "group": "network",
      "excludes": [],
      "must": []
    },
    "TLS Enable": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Enable TLS encryption for Storage communication",
      "example": true,
      "synonyms": ["Enable TLS", "TLSEnable"],
      "group": "tls",
      "excludes": [],
      "must": []
    },
    "TLS Require": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": false,
      "description": "Require TLS connection (reject non-TLS)",
      "example": true,
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS CA Certificate File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to CA certificate file for TLS",
      "example": "/etc/bareos/tls/ca.pem",
      "synonyms": ["TLS CA Cert File", "CA Certificate File"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Certificate": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to client certificate file for Storage",
      "example": "/etc/bareos/tls/client-cert.pem",
      "synonyms": ["TLS Cert", "Certificate"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable", "TLS Key"]
    },
    "TLS Key": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to client private key file",
      "example": "/etc/bareos/tls/client-key.pem",
      "synonyms": ["TLS Private Key", "Private Key"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable", "TLS Certificate"]
    },
    "Enabled": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": true,
      "default": true,
      "description": "Enable or disable this Storage resource (Bareos only)",
      "example": true,
      "min_version": "16.2.0",
      "excludes": [],
      "must": []
    },
    "Paired Storage": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "reference_type": "Storage",
      "description": "Paired Storage for migration/copy jobs (Bareos only)",
      "example": "Tape-Storage",
      "min_version": "13.2.0",
      "excludes": [],
      "must": []
    },
    "Protocol": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "valid_values": ["Native", "NDMP"],
      "default": "Native",
      "description": "Protocol to use for Storage communication (Bareos only)",
      "example": "Native",
      "min_version": "13.2.0",
      "excludes": [],
      "must": []
    },
    "Auth Type": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "valid_values": ["None", "Clear", "MD5"],
      "default": "None",
      "description": "NDMP authentication type (Bareos only)",
      "example": "MD5",
      "min_version": "13.2.0",
      "group": "authentication",
      "excludes": [],
      "must": ["Protocol"]
    },
    "Username": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Username for NDMP authentication (Bareos only)",
      "example": "ndmpuser",
      "min_version": "13.2.0",
      "group": "authentication",
      "excludes": [],
      "must": ["Protocol", "Auth Type"]
    },
    "Collect Statistics": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "default": true,
      "description": "Collect statistics for this Storage (Bareos only)",
      "example": true,
      "min_version": "14.2.0",
      "excludes": [],
      "must": []
    }
  }
}
