{
  "resource_type": "Console",
  "description": "Console resource directives for Bareos and Bacula (the client connecting to Director)",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The name of the Console resource",
      "example": "onesimus-console",
      "group": "authentication",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Optional description of this Console",
      "example": "Onesimus GUI Console",
      "excludes": [],
      "must": []
    },
    "Password": {
      "type": "password",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Password for Console authentication (MD5 hash with [md5] prefix)",
      "example": "[md5]5f4dcc3b5aa765d61d8327deb882cf99",
      "group": "authentication",
      "excludes": [],
      "must": []
    },
    "TLS Enable": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Enable TLS encryption",
      "example": true,
      "synonyms": ["Enable TLS", "TLSEnable"],
      "group": "tls",
      "excludes": [],
      "must": []
    },
    "TLS Require": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": false,
      "description": "Require TLS connection (reject non-TLS)",
      "example": true,
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Verify Peer": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "default": false,
      "description": "Verify peer certificate",
      "example": true,
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS CA Certificate File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to CA certificate file for TLS",
      "example": "/etc/bareos/tls/ca.pem",
      "synonyms": ["TLS CA Cert File", "CA Certificate File"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Certificate": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to Console certificate file",
      "example": "/etc/bareos/tls/console.pem",
      "synonyms": ["TLS Cert", "Certificate"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable", "TLS Key"]
    },
    "TLS Key": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Path to Console private key file",
      "example": "/etc/bareos/tls/console-key.pem",
      "synonyms": ["TLS Private Key", "Private Key"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable", "TLS Certificate"]
    },
    "TLS Allowed CN": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "List of allowed certificate Common Names",
      "example": ["bareos-dir.example.com"],
      "group": "tls",
      "excludes": [],
      "must": ["TLS Enable", "TLS Verify Peer"]
    },
    "Heartbeat Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "min": 0,
      "description": "Keepalive interval in seconds (0 = disabled)",
      "default": 0,
      "example": 300,
      "group": "network",
      "excludes": [],
      "must": []
    },
    "Director": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "reference_type": "Director",
      "description": "Which Director this Console connects to",
      "example": "bareos-dir",
      "excludes": [],
      "must": []
    },
    "Profile": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": true,
      "reference_type": "Profile",
      "description": "Profile resource defining ACLs (Bareos only)",
      "example": "operator",
      "min_version": "12.4.0",
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Command ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Commands this Console can execute",
      "example": ["status", "list", "llist", "query"],
      "valid_values": ["*all*", "status", "list", "llist", "run", "restore", "cancel", "query", "messages", "quit", "exit"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Job ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Jobs this Console can access (regex patterns)",
      "example": ["*all*", "Backup-*", "Restore-*"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Client ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Clients this Console can access",
      "example": ["*all*"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Storage ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Storage resources this Console can access",
      "example": ["*all*"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Pool ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "Pools this Console can access",
      "example": ["*all*", "Full", "Differential", "Incremental"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "FileSet ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "FileSets this Console can access",
      "example": ["*all*"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Catalog ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Catalogs this Console can access",
      "example": ["*all*", "MyCatalog"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Schedule ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Schedules this Console can access",
      "example": ["*all*"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "Where ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": false,
      "description": "Restore locations this Console can use",
      "example": ["/tmp/bareos-restores"],
      "group": "acl",
      "excludes": [],
      "must": []
    },
    "PluginOptions ACL": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": false,
      "use": false,
      "description": "Plugin options this Console can use (Bareos only)",
      "example": ["*all*"],
      "min_version": "15.2.0",
      "group": "acl",
      "excludes": [],
      "must": []
    }
  }
}
