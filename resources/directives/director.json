{
  "resource_type": "Director",
  "description": "Director resource directives for Bareos and Bacula",
  "directives": {
    "Name": {
      "type": "string",
      "required": true,
      "bareos": true,
      "bacula": true,
      "use": true,
      "description": "The name of the Director resource",
      "example": "bareos-dir",
      "excludes": [],
      "must": []
    },
    "Description": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Optional description of this Director",
      "example": "Production Bareos Director",
      "excludes": [],
      "must": []
    },
    "Password": {
      "type": "password",
      "required": true,
      "bareos": true,
      "bacula": true,
      "description": "Password for Director authentication (MD5 hash)",
      "example": "[md5]5f4dcc3b5aa765d61d8327deb882cf99",
      "excludes": [],
      "must": []
    },
    "Messages": {
      "type": "resource_reference",
      "required": false,
      "bareos": true,
      "bacula": true,
      "reference_type": "Messages",
      "description": "Messages resource to use",
      "default": "Daemon",
      "example": "Standard",
      "excludes": [],
      "must": []
    },
    "DirPort": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 1,
      "max": 65535,
      "default": 9101,
      "description": "Port on which the Director listens",
      "example": 9101,
      "excludes": ["DirAddresses"],
      "must": []
    },
    "QueryFile": {
      "type": "path",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Path to query SQL file",
      "default": "/usr/lib/bareos/scripts/query.sql",
      "example": "/usr/lib/bareos/scripts/query.sql",
      "excludes": [],
      "must": []
    },
    "WorkingDirectory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Working directory for temporary files",
      "default": "/var/lib/bareos",
      "example": "/var/lib/bareos",
      "excludes": [],
      "must": []
    },
    "PidDirectory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Directory for process ID files",
      "default": "/var/lib/bareos",
      "example": "/var/lib/bareos",
      "excludes": [],
      "must": []
    },
    "ScriptsDirectory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Directory containing Bareos scripts",
      "default": "/usr/lib/bareos/scripts",
      "example": "/usr/lib/bareos/scripts",
      "excludes": [],
      "must": []
    },
    "PluginDirectory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Directory containing Bareos plugins",
      "example": "/usr/lib/bareos/plugins",
      "excludes": [],
      "must": []
    },
    "SubSysDirectory": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Subsystem directory",
      "example": "/var/run/bareos",
      "excludes": [],
      "must": []
    },
    "Maximum Concurrent Jobs": {
      "type": "integer",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 1,
      "max": 1000,
      "default": 20,
      "description": "Maximum number of Jobs that can run concurrently",
      "example": 50,
      "excludes": [],
      "must": []
    },
    "Heartbeat Interval": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 0,
      "description": "Keepalive interval in seconds (0 = disabled)",
      "default": 0,
      "example": 300,
      "excludes": [],
      "must": []
    },
    "TLS Enable": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "use": true,
      "default": true,
      "description": "Enable TLS encryption",
      "example": true,
      "synonyms": ["Enable TLS", "TLSEnable"],
      "group": "tls",
      "excludes": [],
      "must": []
    },
    "TLS Require": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls",
      "description": "Require TLS connection (yes for x509, no for PSK)",
      "example": true,
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Verify Peer": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls-x509",
      "description": "Verify peer certificate (x509 only)",
      "example": true,
      "excludes": [],
      "must": ["TLS Enable", "TLS CA Certificate File"]
    },
    "TLS CA Certificate File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to CA certificate file (x509 only)",
      "example": "/etc/bareos/tls/bareos-ca.pem",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Certificate": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to certificate file (x509 only)",
      "example": "/etc/bareos/tls/bareos-cert.pem",
      "excludes": [],
      "must": ["TLS Enable", "TLS Key"]
    },
    "TLS Key": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to private key file (x509 only)",
      "example": "/etc/bareos/tls/bareos-key.pem",
      "excludes": [],
      "must": ["TLS Enable", "TLS Certificate"]
    },
    "TLS Allowed CN": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Allowed certificate Common Names (x509 only)",
      "example": ["client1.example.com", "client2.example.com"],
      "excludes": [],
      "must": ["TLS Enable", "TLS Verify Peer"]
    },
    "TLS Authenticate": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": true,
      "default": false,
      "group": "tls",
      "description": "Use TLS only for authentication, not encryption",
      "example": false,
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS CA Certificate Dir": {
      "type": "directory",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to directory containing CA certificates (x509 only)",
      "example": "/etc/bareos/tls/ca",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Cipher List": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-advanced",
      "description": "Colon-separated list of valid TLSv1.2 and lower ciphers",
      "example": "ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Cipher Suites": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "19.2.0",
      "group": "tls-advanced",
      "description": "Colon-separated list of valid TLSv1.3 cipher suites",
      "example": "TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS DH File": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-advanced",
      "description": "Path to Diffie-Hellman parameter file for forward secrecy",
      "example": "/etc/bareos/tls/dh2048.pem",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Protocol": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "20.0.0",
      "group": "tls-advanced",
      "description": "OpenSSL protocol configuration string",
      "example": "-TLSv1,-TLSv1.1",
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "TLS Certificate Revocation List": {
      "type": "file",
      "required": false,
      "bareos": true,
      "bacula": true,
      "group": "tls-x509",
      "description": "Path to Certificate Revocation List file",
      "example": "/etc/bareos/tls/crl.pem",
      "synonyms": ["TLS CRL File"],
      "excludes": [],
      "must": ["TLS Enable"]
    },
    "Statistics Retention": {
      "type": "time",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "16.2.0",
      "description": "Time to retain job statistics (Bareos only)",
      "default": "5 years",
      "example": "5 years",
      "excludes": [],
      "must": []
    },
    "Auditing": {
      "type": "boolean",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "17.2.0",
      "default": false,
      "description": "Enable audit logging (Bareos only)",
      "example": true,
      "excludes": [],
      "must": []
    },
    "Audit Events": {
      "type": "string_list",
      "required": false,
      "bareos": true,
      "bacula": false,
      "min_version": "17.2.0",
      "valid_values": ["all", "security", "config", "job"],
      "description": "Types of events to audit (Bareos only)",
      "example": ["security", "config"],
      "excludes": [],
      "must": ["Auditing"]
    },
    "Secure Erase Command": {
      "type": "string",
      "required": false,
      "bareos": true,
      "bacula": false,
      "description": "Command for secure file deletion (Bareos only)",
      "example": "/usr/bin/shred -n 3 -z -u %s",
      "excludes": [],
      "must": []
    },
    "VerId Retention": {
      "type": "time",
      "required": false,
      "bareos": false,
      "bacula": true,
      "description": "Time to retain version IDs (Bacula only)",
      "default": "1 month",
      "example": "1 month",
      "excludes": [],
      "must": []
    },
    "Maximum Network Buffer Size": {
      "type": "size",
      "required": false,
      "bareos": true,
      "bacula": true,
      "min": 1024,
      "max": 4194304,
      "description": "Maximum network buffer size in bytes",
      "example": 65536,
      "excludes": [],
      "must": []
    },
    "DirAddresses": {
      "type": "addresses",
      "required": false,
      "bareos": true,
      "bacula": true,
      "description": "Network addresses and ports to listen on",
      "example": "{ ipv4 = { addr = 0.0.0.0; port = 9101; } }",
      "excludes": ["DirPort"],
      "must": []
    }
  }
}
