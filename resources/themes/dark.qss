/* Onesimus Dark Theme - Industrial Design */

/* Main Application
   No font here: family and size are the desktop's font times the interface
   zoom (BUiScale). A size in a theme would override both. */
QWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    alternate-background-color: #252526;
    selection-background-color: #094771;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* Menu Bar */
QMenuBar {
    background-color: #252526;
    color: #d4d4d4;
    border-bottom: 1px solid #3e3e42;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #37373d;
}

QMenuBar::item:pressed {
    background-color: #094771;
}

/* Menus */
QMenu {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
}

QMenu::item {
    padding: 5px 25px 5px 25px;
}

QMenu::item:selected {
    background-color: #094771;
}

QMenu::separator {
    height: 1px;
    background-color: #3e3e42;
    margin: 5px 0;
}

/* Tool Bar */
QToolBar {
    background-color: #252526;
    border: 1px solid #3e3e42;
    spacing: 3px;
    padding: 3px;
}

QToolBar::separator {
    background-color: #3e3e42;
    width: 1px;
    height: 1px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #37373d;
    border: 1px solid #3e3e42;
}

QToolButton:pressed {
    background-color: #094771;
}

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    border-top: 1px solid #3e3e42;
}

QStatusBar QLabel {
    background-color: transparent;
    color: #ffffff;
    padding: 2px 5px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    background-color: #1e1e1e;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #969696;
    border: 1px solid #3e3e42;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-bottom: 2px solid #007acc;
}

QTabBar::tab:hover {
    background-color: #37373d;
    color: #d4d4d4;
}

/* Push Button */
QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border: 1px solid #007acc;
    border-radius: 3px;
    padding: 5px 15px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #094771;
}

QPushButton:disabled {
    background-color: #3e3e42;
    color: #666666;
    border: 1px solid #3e3e42;
}

/* The counter of predicted waits in the schedule view opens a list below
   the timeline. Closed it is an outlined button, open a filled one; the
   arrow in its text says the same. */
QPushButton[disclosure="true"] {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #6a6a6a;
}

QPushButton[disclosure="true"]:hover {
    background-color: #37373d;
}

QPushButton[disclosure="true"]:checked {
    background-color: #0e639c;
    color: #ffffff;
    border: 1px solid #3794ff;
}

QPushButton[disclosure="true"]:checked:hover {
    background-color: #1177bb;
}

QPushButton[disclosure="true"]:focus {
    border: 2px solid #d4d4d4;
    padding: 4px 14px;
}

/* Line Edit */
QLineEdit {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px;
    selection-background-color: #094771;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

QLineEdit:disabled {
    background-color: #2d2d30;
    color: #666666;
}

/* Combo Box */
QComboBox {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px;
    min-width: 120px;
}

QComboBox:hover {
    border: 1px solid #007acc;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/icons/icons/arrow-down-ondark.svg);
    width: 10px;
    height: 6px;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    selection-background-color: #094771;
}

/* Spin Box */
QSpinBox {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #37373d;
}

/* The buttons are styled, so their arrows must be too: without an image
   no arrow is drawn */
QSpinBox::up-arrow {
    image: url(:/icons/icons/arrow-up-ondark.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow {
    image: url(:/icons/icons/arrow-down-ondark.svg);
    width: 8px;
    height: 5px;
}

/* Check Box */
QCheckBox {
    color: #d4d4d4;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    background-color: #3c3c3c;
}

QCheckBox::indicator:checked {
    background-color: #007acc;
    border: 1px solid #007acc;
}

QCheckBox::indicator:hover {
    border: 1px solid #007acc;
}

/* Radio Button */
QRadioButton {
    color: #d4d4d4;
    spacing: 5px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3e3e42;
    border-radius: 9px;
    background-color: #3c3c3c;
}

QRadioButton::indicator:checked {
    background-color: #007acc;
    border: 1px solid #007acc;
}

/* Group Box */
QGroupBox {
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #007acc;
}

/* Table View */
QTableView {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #d4d4d4;
    gridline-color: #3e3e42;
    border: 1px solid #3e3e42;
    selection-background-color: #094771;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #d4d4d4;
    padding: 5px;
    border: 1px solid #3e3e42;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #37373d;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e4e4e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4e4e4e;
}

/* Text Edit */
QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    selection-background-color: #094771;
}

/* List View */
QListView {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    selection-background-color: #094771;
}

/* Dock Widget */
QDockWidget {
    color: #d4d4d4;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

QDockWidget::title {
    background-color: #2d2d30;
    padding: 5px;
    border: 1px solid #3e3e42;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: none;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #37373d;
}

/* Splitter */
QSplitter::handle {
    background-color: #3e3e42;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Tool Tip */
QToolTip {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #007acc;
    padding: 5px;
}

/* Progress Bar */
QProgressBar {
    background-color: #3c3c3c;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    text-align: center;
    color: #d4d4d4;
}

QProgressBar::chunk {
    background-color: #007acc;
    border-radius: 2px;
}

/* Label */
QLabel {
    color: #d4d4d4;
    background-color: transparent;
}

/* Status Bar Labels */
QStatusBar QLabel#connectionLabel {
    color: #ffffff;
    font-weight: bold;
    padding: 2px 8px;
}

QStatusBar QLabel#connectionLabel[connected="true"] {
    color: #7fff7f;
}

QStatusBar QLabel#connectionLabel[connected="false"] {
    color: #aaaaaa;
}

QStatusBar QLabel#statusLabel {
    color: #ffffff;
    padding: 2px 8px;
}

/* ============================================================
   Semantic state labels  (set via setProperty("state", "..."))
   ============================================================ */
QLabel[state="success"] { color: #6af06a; font-weight: bold; }
QLabel[state="info"]    { color: #6af06a; }
QLabel[state="warning"] { color: orange; font-weight: bold; }
QLabel[state="error"]   { color: #ff6b6b; }
QLabel[state="muted"]   { color: #888888; }

/* Hint / instructional text in dialogs */
QLabel#hintLabel {
    color: #888888;
    font-style: italic;
    margin-top: 16px;
}

/* Hash / fingerprint display; its fixed-pitch font is set in the code */
QLabel#md5HashLabel {
    color: #888888;
}

/* Client statistics bar */
QLabel#clientStatsBoldLabel { font-weight: bold; }
QLabel#clientOnlineLabel    { font-weight: bold; color: #6af06a; }
QLabel#clientOnlineValue    { color: #6af06a; }
QLabel#clientOfflineLabel   { font-weight: bold; color: #888888; }
QLabel#clientOfflineValue   { color: #888888; }

/* Level Filter Checkboxes
   background-color / color are appended dynamically by applyTheme()
   via BLevelColors::generateLevelQss() using QCheckBox[level="X"] selectors. */
QCheckBox[level] {
    padding: 3px;
    border-radius: 3px;
}

/* ============================================================
   Gantt / Schedule Timeline Widget
   Custom-painted; inherits palette roles from global QWidget rule.
   Override here only if the Gantt needs values different from the theme defaults.
   ============================================================ */
BScheduleGanttWidget {
    border: none;
}

/* ============================================================
   Schedule grid view
   The grid, its legend and the calendar are custom-painted from the
   palette roles of the global QWidget rule and the level colours.
   Rules are needed only for the scope bar, whose buttons act as tabs
   (the checked one is the scope on display, one without Run lines is
   dimmed), for the notice about lines that are not understood, and
   for what editing adds (at the end of this block).
   ============================================================ */
BScheduleGridWidget {
    border: none;
}

QToolButton[scopeButton="true"] {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 4px 12px;
}

QToolButton[scopeButton="true"]:hover {
    background-color: #37373d;
}

QToolButton[scopeButton="true"]:checked {
    background-color: #094771;
    border: 1px solid #007acc;
    color: #ffffff;
    font-weight: bold;
}

QToolButton[scopeButton="true"]:focus {
    border: 2px solid #d4d4d4;
    padding: 3px 11px;
}

QToolButton[scopeEmpty="true"] {
    color: #8a8a8a;
    font-style: italic;
}

QLabel#scheduleGridNotice {
    color: #e0a030;
    font-weight: bold;
}

/* Editing in the grid. The palette: the checked button is the tool in
   hand. "+" adds a scope. The buttons of the calendar rule form stand for
   single days, weeks and hours; a checked one is filled. */
QToolButton[paletteButton="true"] {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 3px 8px;
}

QToolButton[paletteButton="true"]:hover {
    background-color: #37373d;
}

QToolButton[paletteButton="true"]:checked {
    background-color: #094771;
    border: 2px solid #3794ff;
    padding: 2px 7px;
    color: #ffffff;
}

QToolButton[paletteButton="true"]:focus {
    border: 2px solid #d4d4d4;
    padding: 2px 7px;
}

QToolButton#scheduleGridAddScope {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 4px 10px;
    font-weight: bold;
}

QToolButton#scheduleGridAddScope:hover {
    background-color: #37373d;
}

QToolButton#scheduleGridAddScope:focus {
    border: 2px solid #d4d4d4;
    padding: 3px 9px;
}

/* A schedule with a Run line that is not understood is locked: the palette
   and "+" are disabled and look so; the tool in hand is still shown */
QToolButton[paletteButton="true"]:disabled,
QToolButton#scheduleGridAddScope:disabled {
    background-color: #2d2d30;
    color: #666666;
    border: 1px solid #3e3e42;
}

QToolButton[paletteButton="true"]:checked:disabled {
    background-color: #3e3e42;
    border: 2px solid #666666;
    padding: 2px 7px;
    color: #666666;
}

QToolButton[maskButton="true"] {
    background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 2px;
    padding: 3px 2px;
}

QToolButton[maskButton="true"]:hover {
    background-color: #37373d;
}

QToolButton[maskButton="true"]:checked {
    background-color: #0e639c;
    border: 1px solid #3794ff;
    color: #ffffff;
    font-weight: bold;
}

QToolButton[maskButton="true"]:focus {
    border: 2px solid #d4d4d4;
    padding: 2px 1px;
}

QToolButton[maskButton="true"]:disabled {
    color: #6a6a6a;
    background-color: #1e1e1e;
}

QLabel#scheduleGridModified {
    color: #e0a030;
    font-weight: bold;
}

QFrame#scheduleGridPending {
    background-color: #3b2f0b;
    border: 1px solid #e0a030;
    border-radius: 3px;
}

/* Status tokens: colours of the status chips (BStatusDelegate), the job
   log marks, the job details and the statistics bars. Read by the hidden
   BStatusPalette widget; the same values are built into src/bstatuschip.cpp.
   Green (success) is for a job that terminated normally ('T') only. */
BStatusPalette {
    qproperty-neutralBackground: #333337;
    qproperty-neutralForeground: #cccccc;
    qproperty-neutralAccent: #6e6e73;
    qproperty-successBackground: #1d3b24;
    qproperty-successForeground: #8fe39c;
    qproperty-successAccent: #3fa452;
    qproperty-warningBackground: #45360f;
    qproperty-warningForeground: #ffd36b;
    qproperty-warningAccent: #d89b14;
    qproperty-errorBackground: #4a1d1d;
    qproperty-errorForeground: #ff9e9e;
    qproperty-errorAccent: #d9473f;
    qproperty-runningBackground: #11314d;
    qproperty-runningForeground: #8fc9ff;
    qproperty-runningAccent: #3a8fd9;
    qproperty-waitingBackground: #2a313b;
    qproperty-waitingForeground: #b7c4d4;
    qproperty-waitingAccent: #6c7d93;
    qproperty-infoBackground: #123a38;
    qproperty-infoForeground: #82d9cf;
    qproperty-infoAccent: #2f9e92;
}

QProgressBar[state="success"]::chunk { background-color: #3fa452; }
QProgressBar[state="warning"]::chunk { background-color: #d89b14; }
QProgressBar[state="error"]::chunk { background-color: #d9473f; }

/* Recently active (a client's last backup): a fact, not a verified success */
QLabel[state="active"]  { color: #82d9cf; font-weight: bold; }
