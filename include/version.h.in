#pragma once

// Generated by CMake at configure time into <build>/generated/version.h.
// Only values that stay the same from one build to the next live here, so the
// files including this header are not recompiled on every build. The values
// that change (build number, source date, git state) are defined in the
// generated <build>/generated/buildinfo.cpp (cmake/BuildInfo.cmake), declared
// below: a new build number recompiles that one file.

#define PROJECT_VERSION        "@PROJECT_VERSION@"
#define PROJECT_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define PROJECT_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define PROJECT_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define PROJECT_NAME           "@PROJECT_NAME@"

// Build configuration
#define COMPILER_ID            "@CMAKE_CXX_COMPILER_ID@"
#define COMPILER_VERSION       "@CMAKE_CXX_COMPILER_VERSION@"

// Copyright
#define PROG_COPYRIGHT         "Copyright (C) 2025-2026 Joerg Bernau.\n"

namespace BuildInfo {
// Build number: the CI run number (GITHUB_RUN_NUMBER), else the number of
// commits up to HEAD; a counter in the build directory with
// -DONESIMUS_INCREMENT_BUILD=ON.
extern const int number;
// PROJECT_VERSION "." number, e.g. "0.3.0.512"
extern const char *const versionFull;
// Date and time (UTC) of the source: SOURCE_DATE_EPOCH, else the commit date of HEAD
extern const char *const sourceDate; // "YYYY-MM-DD"
extern const char *const sourceTime; // "HH:MM:SS"
extern const char *const gitCommit;   // short hash
extern const char *const gitBranch;
extern const char *const gitDescribe; // git describe --always --dirty
} // namespace BuildInfo
